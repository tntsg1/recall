static func t(key: String) -> String:
	var v: Array = S.get(key, [key, key])
	return v[0] if zh else v[1]


# Break a text into lines no wider than `width`: a "\n" always starts a new
# line, and English breaks between words when it can.
static func wrap(font: Font, txt: String, size: int, width: float) -> Array:
	var out: Array = []
	for para in txt.split("\n"):
		var cur := ""
		for ch in para:
			var test := cur + ch
			if font.get_string_size(test, HORIZONTAL_ALIGNMENT_LEFT, -1, size).x > width and cur != "":
				var sp := cur.rfind(" ")
				if ch != " " and sp > cur.length() / 2:
					out.append(cur.substr(0, sp))
					cur = cur.substr(sp + 1) + ch
				else:
					out.append(cur)
					cur = ch.strip_edges(true, false)
			else:
				cur = test
		if cur != "":
			out.append(cur)
	return out
