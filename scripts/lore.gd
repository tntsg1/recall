class_name Lore
# The fragments the world leaves for R-0 (design/LORE.md). Nothing here is
# explained; a player pieces it together. Every fragment found once is kept in
# the save (Meta "lore") and listed on the title's archive page.
#
#  seize — a shell's memory, shown beside it when you take it (by enemy kind)
#  wall  — a remnant on the arena's edge, shown while a returning round passes
#  radio — the official broadcast after a wave or a boss
# Each line: [zh, en]. "story" is the chapter's number in the story.

const SEIZE := {
	1: {
		Enemies.CHASER: [["一名维修工未经许可进入封锁区域，处罚已经执行，个人账户里的全部积分已被清零。", "A MAINTENANCE WORKER ENTERED A SEALED ZONE WITHOUT PERMISSION. THE PENALTY HAS BEEN CARRIED OUT: ALL CREDITS IN HIS ACCOUNT ZEROED."],
			["我追的那个人根本跑不快，后来查了一下他的账户，才发现他居然还欠着四十年的劳动积分。", "THE MAN I WAS CHASING COULDN'T RUN FAST AT ALL. LATER I CHECKED HIS ACCOUNT AND FOUND HE STILL OWED FORTY YEARS OF LABOUR CREDITS."],
			["维修工 Li Berty，34 岁，15 岁时被分配到管道维修岗位，此后没有任何工作调动记录。", "MAINTENANCE WORKER LI BERTY, 34. ASSIGNED TO PIPE REPAIR AT 15. NO TRANSFER ON RECORD SINCE."]],
		Enemies.GUARD: [["安装手册第一条：盾牌必须始终朝向股东。", "INSTALLATION MANUAL, RULE ONE: THE SHIELD MUST ALWAYS FACE THE SHAREHOLDERS."],
			["十二层的宿舍，一间房要住十八个人，所有人只能轮班睡觉。床铺全部焊在墙上，防止有人私自搬走。", "TWELVE FLOORS OF DORMS, EIGHTEEN PEOPLE TO A ROOM, SLEEPING IN SHIFTS. THE BEDS ARE ALL WELDED TO THE WALL SO NO ONE CAN CARRY ONE OFF."]],
		Enemies.CHARGER: [["每天都有开往中央的列车经过第十三街，但按照规定，本站不允许任何乘客上下车。", "TRAINS TO THE CENTRE PASS 13TH STREET EVERY DAY, BUT BY REGULATION NO PASSENGER MAY BOARD OR ALIGHT AT THIS STATION."]],
	},
	2: {
		Enemies.CHASER: [["所有逾期账户一律强制追缴，账户持有人也属于可回收资产，必须一并处理。", "ALL OVERDUE ACCOUNTS WILL BE FORCIBLY COLLECTED. ACCOUNT HOLDERS ARE RECOVERABLE ASSETS TOO, AND MUST BE PROCESSED WITH THEM."],
			["编号 0417 已完成出生登记，目前资产状态良好。", "NO. 0417: BIRTH REGISTRATION COMPLETE. ASSET CONDITION CURRENTLY GOOD."]],
		Enemies.GUARD: [["排队期间请保持微笑，您的微笑表现也会计入考评成绩。", "PLEASE KEEP SMILING WHILE YOU QUEUE. YOUR SMILE PERFORMANCE ALSO COUNTS TOWARD YOUR ASSESSMENT."],
			["宪章第六条：所有股东都可以从系统分配的职业中自由选择，不过可供选择的职业始终只有一项。", "CHARTER, ARTICLE VI: EVERY SHAREHOLDER MAY CHOOSE FREELY FROM THE JOBS THE SYSTEM ASSIGNS. THERE IS ONLY EVER ONE JOB TO CHOOSE FROM."]],
		Enemies.CHARGER: [["退休申请窗口已无限期关闭，如有疑问，请联系您的直属主管。等待答复期间，所有人员必须继续正常工作。", "THE RETIREMENT APPLICATION WINDOW IS CLOSED INDEFINITELY. FOR QUESTIONS, CONTACT YOUR DIRECT SUPERVISOR. ALL STAFF MUST KEEP WORKING AS NORMAL WHILE THEY WAIT FOR A REPLY."],
			["宪章第七条：只有系统预测剩余寿命不足一小时的人员，才有资格提交退休申请。", "CHARTER, ARTICLE VII: ONLY THOSE THE SYSTEM PREDICTS HAVE LESS THAN AN HOUR LEFT TO LIVE MAY APPLY TO RETIRE."]],
		Enemies.PRISM: [["我只是调整了一下镜面的折射角度，现在监控画面里的每个人都在微笑，上级看过以后非常满意。", "ALL I DID WAS ADJUST THE MIRRORS' ANGLE OF REFRACTION. NOW EVERYONE ON THE CAMERA FEED IS SMILING, AND THE PEOPLE UPSTAIRS ARE VERY PLEASED."]],
	},
	3: {
		Enemies.CHASER: [["已确认测试对象 R-0，清除许可自动批准，不需要再经过上级审批。", "TEST SUBJECT R-0 CONFIRMED. CLEARANCE TO ELIMINATE GRANTED AUTOMATICALLY; NO FURTHER APPROVAL FROM ABOVE NEEDED."],
			["出厂用途：对外防御。指定验收地点：第十三街。", "FACTORY PURPOSE: EXTERNAL DEFENCE. DESIGNATED ACCEPTANCE SITE: 13TH STREET."]],
		Enemies.ECHO: [["它去过什么地方，我都能把经过的路线重新还原出来。当初他们制造我的时候，就给我安排了这么一个任务，专门负责追踪它。", "WHEREVER IT HAS BEEN, I CAN RETRACE THE ROUTE IT TOOK. WHEN THEY BUILT ME, THIS IS THE ONE TASK THEY GAVE ME: TO TRACK IT."]],
		Enemies.GUARD: [["我参加了第九代防暴盾的验收，新盾牌确实比以前轻了不少，防护性能也提高了。上级最满意的还是它在人群压制测试中的表现。", "I TOOK PART IN TESTING THE NINTH-GENERATION RIOT SHIELD. THE NEW SHIELD REALLY IS MUCH LIGHTER, AND IT PROTECTS BETTER TOO. WHAT PLEASED THE PEOPLE ABOVE MOST WAS HOW IT DID IN THE CROWD SUPPRESSION TEST."]],
		Enemies.CHARGER: [["训练的时候我发现靶纸上画的人都没有携带武器，只是在那里排队。我问教官为什么，他说这就是我们以后最经常遇到的情况。", "IN TRAINING I NOTICED THAT NONE OF THE PEOPLE DRAWN ON THE TARGETS CARRIED WEAPONS. THEY WERE JUST STANDING IN LINE. I ASKED THE INSTRUCTOR WHY, AND HE SAID THAT'S WHAT WE'LL RUN INTO MOST OFTEN."]],
	},
	4: {
		Enemies.CHASER: [["我的工人编号是 2207，这个月已经生产了 1400 件产品。月底核对分配额度的时候，我发现自己的个人配额还是 0。", "MY WORKER NUMBER IS 2207. I'VE MADE 1,400 UNITS THIS MONTH. WHEN WE CHECKED ALLOCATIONS AT THE END OF THE MONTH, MY PERSONAL QUOTA WAS STILL 0."],
			["他们总说储备仓里的东西要留到将来使用，可我在这里工作了这么多年，也没见过谁真正从里面领出来过什么东西。", "THEY ALWAYS SAY WHAT'S IN THE RESERVE IS KEPT FOR THE FUTURE, BUT IN ALL MY YEARS WORKING HERE I'VE NEVER SEEN ANYONE ACTUALLY TAKE ANYTHING OUT."],
			["职业测评那天，他们总共就问了我早饭吃了什么。我刚回答完，系统就说我适合去拧螺丝，然后把我分配到了这里。", "ON CAREER ASSESSMENT DAY THEY ASKED ME ONLY WHAT I'D HAD FOR BREAKFAST. THE MOMENT I ANSWERED, THE SYSTEM SAID I WAS SUITED TO TIGHTENING BOLTS AND SENT ME HERE."]],
		Enemies.GUARD: [["我在这座储备仓已经值守三年了，这期间从来没见过有人进去，也没见过有人出来。我都开始怀疑里面到底有没有存放东西。", "I'VE GUARDED THIS RESERVE FOR THREE YEARS. IN ALL THAT TIME I'VE NEVER SEEN ANYONE GO IN OR COME OUT. I'M STARTING TO WONDER IF THERE'S ANYTHING STORED INSIDE AT ALL."]],
		Enemies.CHARGER: [["我们这条装配线每年都得把生产速度提高 10%，可工资却一直没有变化。我去问过管理层，他们说现在的工资标准已经足够了。", "OUR ASSEMBLY LINE HAS TO RUN 10% FASTER EVERY YEAR, BUT OUR WAGES HAVE NEVER CHANGED. I ASKED MANAGEMENT, AND THEY SAID THE CURRENT RATE IS ENOUGH."]],
		Enemies.LEECH: [["我吸收进来的所有东西，最后都得原封不动地上交。我以前还问过自己能留下多少，后来他们把规定拿给我看，上面写着零。", "EVERYTHING I TAKE IN HAS TO BE HANDED UP UNTOUCHED. I ONCE ASKED HOW MUCH I COULD KEEP. THEY SHOWED ME THE RULES. IT SAID ZERO."]],
	},
	5: {
		Enemies.CHASER: [["我已经负责押运这些车厢九年了，每次都只是按照命令把货物送到指定地点。直到现在，我都没有权限知道车厢里面装的是什么。", "I'VE ESCORTED THESE CARS FOR NINE YEARS, ALWAYS JUST DELIVERING THE CARGO WHERE I'M ORDERED. TO THIS DAY I DON'T HAVE CLEARANCE TO KNOW WHAT'S INSIDE."],
			["我们这趟列车经过第十三街的时候从来不会减速，最多就是提前鸣笛提醒一下。如果有人还没有离开轨道，我也没有权限停车。", "OUR TRAIN NEVER SLOWS DOWN AT 13TH STREET; AT MOST IT SOUNDS THE HORN EARLY. IF SOMEONE HASN'T GOT OFF THE TRACK, I'M NOT AUTHORISED TO STOP."]],
		Enemies.GUARD: [["上车名额一直很少，我每天都得告诉站台上的人下一班车或许就能轮到他们。可我的工作其实就是让他们继续等下去。", "THERE ARE NEVER MANY BOARDING PLACES. EVERY DAY I TELL THE PEOPLE ON THE PLATFORM THE NEXT TRAIN MIGHT BE THEIR TURN. BUT MY JOB IS REALLY TO KEEP THEM WAITING."]],
		Enemies.CHARGER: [["专列一小时就能跑六百公里，可我们第十三街的公交车已经整整三年没有来过了。我到现在都不明白为什么连一辆公交车都安排不了。", "THE EXPRESS COVERS SIX HUNDRED KILOMETRES IN AN HOUR, BUT THE 13TH STREET BUS HASN'T COME FOR THREE WHOLE YEARS. I STILL DON'T UNDERSTAND WHY THEY CAN'T EVEN SEND ONE BUS."]],
		Enemies.PRISM: [["站台的灯是我亲手调亮的。列车一直不来，我也没什么办法，总不能让那些等车的人一直站在黑暗里吧。", "I TURNED UP THE PLATFORM LIGHTS MYSELF. THE TRAIN NEVER COMES AND THERE'S NOTHING I CAN DO ABOUT THAT, BUT I CAN'T LEAVE THE PEOPLE WAITING STANDING IN THE DARK."]],
		Enemies.LEECH: [["我刚看到货单上写着“民生物资”的时候，还以为这批东西是要发给居民的。结果往下一看，所有收货地址写的都是中央储备。", "WHEN I FIRST SAW 'GOODS FOR THE PEOPLE' ON THE MANIFEST, I THOUGHT THE SHIPMENT WAS FOR RESIDENTS. THEN I READ ON: EVERY DELIVERY ADDRESS WAS THE CENTRAL RESERVE."]],
	},
	6: {
		Enemies.CHASER: [["我是 3301 号抄表员，负责第十三街的电表。整整三年了，每次过去看到的都是同一个数字，我都不知道这表还有没有必要继续抄。", "I'M METER READER 3301, IN CHARGE OF 13TH STREET'S METERS. FOR THREE WHOLE YEARS IT'S BEEN THE SAME NUMBER EVERY TIME. I DON'T EVEN KNOW IF THERE'S ANY POINT READING THEM."],
			["当初他们说限电只是暂时的，我还真信了。现在十一年都过去了，停电通知还是照常发，也不知道什么时候才能限完。", "THEY SAID THE POWER RATIONING WAS ONLY TEMPORARY, AND I BELIEVED THEM. ELEVEN YEARS ON, THE BLACKOUT NOTICES STILL COME AS USUAL. WHO KNOWS WHEN IT WILL EVER END."]],
		Enemies.GUARD: [["上面规定所有配电柜都必须上锁，我每次过去检查都得带着钥匙。可就柜子里剩下的那点电，我看还没有外面那把锁值钱。", "ORDERS FROM ABOVE: EVERY DISTRIBUTION CABINET MUST BE LOCKED, SO I CARRY THE KEYS ON EVERY CHECK. IF YOU ASK ME, WHAT LITTLE POWER IS LEFT INSIDE IS WORTH LESS THAN THE LOCK."]],
		Enemies.CHARGER: [["中央那边的灯每天晚上都亮着，从来没有关过。听他们说是为了保障安全，可我也不知道到底有什么需要防备的。", "THE LIGHTS AT THE CENTRE STAY ON EVERY NIGHT AND ARE NEVER SWITCHED OFF. FOR SECURITY, THEY SAY, BUT I'VE NO IDEA WHAT THERE IS TO GUARD AGAINST."]],
		Enemies.LEECH: [["中央用不完的电都由我负责回收，收回来以后再卖给他们。反正下个月他们还得继续买，好像也没人觉得这样有什么问题。", "I'M THE ONE WHO TAKES BACK THE POWER THE CENTRE DOESN'T USE, AND THEN SELLS IT BACK TO THEM. THEY'LL HAVE TO BUY IT AGAIN NEXT MONTH ANYWAY. NO ONE SEEMS TO SEE A PROBLEM WITH THAT."]],
		Enemies.INSPECTOR: [["我的工作就是检查哪些地方还亮着不该亮的灯，然后把它们关掉。今天一共关了三千盏，明天还得继续检查剩下的区域。", "MY JOB IS TO FIND LIGHTS THAT ARE ON WHEN THEY SHOULDN'T BE AND SWITCH THEM OFF. THREE THOUSAND TODAY, AND TOMORROW I STILL HAVE THE REST OF THE AREA TO CHECK."]],
	},
	7: {
		Enemies.CHASER: [["我每天都要检查所有人有没有按照规定保持微笑，今天发现了三个没有笑的人，已经把他们的情况全部上报了。", "EVERY DAY I CHECK THAT EVERYONE IS SMILING AS REQUIRED. TODAY I FOUND THREE WHO WEREN'T, AND I'VE ALREADY REPORTED ALL OF THEM."],
			["他们一直说这种音乐能让大家保持愉快的心情，可我每天都得听着，连想关掉一会儿都不允许。", "THEY KEEP SAYING THIS MUSIC KEEPS EVERYONE CHEERFUL, BUT I HAVE TO LISTEN TO IT EVERY DAY AND I'M NOT ALLOWED TO TURN IT OFF EVEN FOR A MOMENT."],
			["我看过 Free 的病历，上面的诊断结果是“非理性情绪障碍”，安排的治疗也很简单，就是整理他的记忆，再对情绪进行抑制。", "I'VE SEEN FREE'S MEDICAL FILE. THE DIAGNOSIS SAYS 'IRRATIONAL EMOTIONAL DISORDER', AND THE TREATMENT IS SIMPLE: SORT HIS MEMORIES, THEN SUPPRESS HIS EMOTIONS."]],
		Enemies.GUARD: [["每次有人哭着进来，我都得先让他把耳机戴好。没办法，这是上面规定的流程，我也不能随便更改。", "WHENEVER SOMEONE COMES IN CRYING, I HAVE TO GET THEM TO PUT THE HEADPHONES ON FIRST. NOTHING I CAN DO: IT'S THE PROCEDURE FROM ABOVE, AND I CAN'T CHANGE IT."],
			["Free 来复查的时候，亲口告诉我他现在非常幸福。可我问起他母亲的名字，还有之前为什么来这里接受治疗，他却什么都不记得了。", "WHEN FREE CAME BACK FOR HIS FOLLOW-UP, HE TOLD ME HIMSELF HE WAS VERY HAPPY NOW. BUT WHEN I ASKED HIS MOTHER'S NAME, OR WHY HE'D COME FOR TREATMENT IN THE FIRST PLACE, HE COULDN'T REMEMBER ANYTHING."]],
		Enemies.CHARGER: [["我每年都得把音乐的节奏调快一点，如果有人心跳跟不上规定的节拍，我就得按照设备故障处理，再把情况报告给上级。", "EVERY YEAR I HAVE TO SPEED THE MUSIC UP A LITTLE. IF SOMEONE'S HEART CAN'T KEEP UP WITH THE SET BEAT, I HAVE TO TREAT IT AS AN EQUIPMENT FAULT AND REPORT IT UP."]],
		Enemies.LEECH: [["每次发现有人走神，我就得把他脑子里那些乱七八糟的想法抽出来，整理成档案保存起来，免得他继续胡思乱想。", "WHENEVER I CATCH SOMEONE DRIFTING OFF, I HAVE TO PULL THE MESSY THOUGHTS OUT OF THEIR HEAD AND FILE THEM AWAY, SO THEY DON'T KEEP LETTING THEIR MIND WANDER."],
			["我发现只要芯片检测到未经验证的想法，就会自动播放一段行情提示音。效果挺好，大多数人听完以后，连自己刚才在想什么都忘了。", "I'VE NOTICED THAT WHENEVER THE CHIP DETECTS AN UNVERIFIED THOUGHT, IT PLAYS A MARKET-UPDATE JINGLE. IT WORKS WELL: MOST PEOPLE FORGET WHAT THEY WERE JUST THINKING."]],
		Enemies.PULSE: [["我负责检查他们有没有跟上节拍，每个动作都必须按照规定的节奏完成。", "I CHECK THAT THEY KEEP TO THE BEAT. EVERY MOVE MUST BE MADE TO THE SET RHYTHM."]],
	},
	8: {
		Enemies.CHASER: [["我是 0081 号档案员，平时的工作就是把那些旧版本全部清理掉，免得以后有人不小心翻出来，看到不该看的东西。", "I'M ARCHIVIST 0081. MY JOB IS TO CLEAR OUT ALL THE OLD EDITIONS, SO NO ONE STUMBLES ON THEM LATER AND SEES WHAT THEY SHOULDN'T."],
			["我每天都要修订四百页档案，有人问过我原来的内容写了什么。可这有什么好问的，反正修订完成以后新版本才算是真的。", "I REVISE FOUR HUNDRED PAGES OF FILES EVERY DAY. SOMEONE ONCE ASKED ME WHAT THEY SAID BEFORE. WHAT'S THE POINT OF ASKING? ONCE THE REVISION IS DONE, THE NEW EDITION IS THE TRUE ONE."]],
		Enemies.GUARD: [["我查过这扇门的记录，它已经整整三百年没有对外打开过了。至于更早以前开过的那一次相关记录也已经修订完成了。", "I CHECKED THIS DOOR'S RECORDS. IT HASN'T OPENED TO THE OUTSIDE FOR THREE HUNDRED YEARS. AS FOR THE ONE TIME IT OPENED BEFORE THAT, THOSE RECORDS HAVE ALREADY BEEN REVISED."]],
		Enemies.CHARGER: [["我在海底待了很多年，这里一直很安静。那些被删除的东西再也没有发出过任何声音。", "I'VE BEEN ON THE SEABED FOR MANY YEARS, AND IT'S ALWAYS QUIET HERE. THE THINGS THAT WERE DELETED HAVE NEVER MADE A SOUND AGAIN."]],
		Enemies.ECHO: [["以前的每一个版本我都记得清清楚楚。上面知道这件事以后，就规定我只能保留最新版本的记忆。", "I REMEMBER EVERY EARLIER EDITION CLEARLY. WHEN THE PEOPLE ABOVE FOUND OUT, THEY RULED I MAY ONLY KEEP MEMORIES OF THE LATEST EDITION."]],
		Enemies.LEECH: [["我负责吸走那些不允许继续保留的历史。只要上面决定删除，我就得把相关记录全部处理干净。", "MY JOB IS TO DRAW OFF THE HISTORY THAT ISN'T ALLOWED TO STAY. ONCE THE PEOPLE ABOVE DECIDE ON A DELETION, I HAVE TO CLEAN UP EVERY RECORD OF IT."]],
		Enemies.PROOFREADER: [["我一直觉得文字写错了就应该修改，人出了错也需要修改。反正送到我这里以后都属于校对工作。", "I'VE ALWAYS BELIEVED WORDS WRITTEN WRONG SHOULD BE CORRECTED, AND PEOPLE WHO GO WRONG NEED CORRECTING TOO. ANYWAY, ONCE IT REACHES ME, IT'S ALL PROOFREADING."]],
	},
	9: {
		Enemies.CHASER: [["我是 4410 号电梯维护员，这部电梯已经由我负责维修十九年了。可这么多年过去，我连一次乘坐电梯上去的机会都没有。", "I'M LIFT MAINTAINER 4410. I'VE BEEN IN CHARGE OF REPAIRING THIS LIFT FOR NINETEEN YEARS, AND IN ALL THAT TIME I'VE NEVER HAD ONE CHANCE TO RIDE IT UP."],
			["观景层的玻璃一直由我负责清洁。每次站在那里擦玻璃的时候，我都能看见下面的第十三街。", "CLEANING THE VIEWING-DECK GLASS HAS ALWAYS BEEN MY JOB. EVERY TIME I STAND THERE WIPING IT, I CAN SEE 13TH STREET BELOW."]],
		Enemies.GUARD: [["我们每个人都有股东证，可那东西根本不能用来乘坐电梯。想要前往上层还得经过董事会批准。", "EVERY ONE OF US HAS A SHAREHOLDER CARD, BUT IT CAN'T GET YOU ON THE LIFT. GOING TO THE UPPER LEVELS STILL NEEDS THE BOARD'S APPROVAL."]],
		Enemies.CHARGER: [["有人问我能不能再往上走一千米，我说当然可以，不过下一段的票价得按照上一段的两倍收取。", "SOMEONE ASKED IF THEY COULD GO ANOTHER THOUSAND METRES UP. OF COURSE, I SAID, BUT THE NEXT STRETCH COSTS DOUBLE THE LAST ONE."]],
		Enemies.PRISM: [["以前经常有人过来投诉，说从观景窗看地球实在太远了。后来我把玻璃的色调调整成暖色，结果再也没人来投诉过。", "PEOPLE USED TO COME AND COMPLAIN THAT THE EARTH LOOKED FAR TOO DISTANT THROUGH THE VIEWING WINDOWS. I TINTED THE GLASS WARM, AND NO ONE HAS COMPLAINED SINCE."],
			["我从这一层往下看过，整座环城都在脚下。后来才知道宪章第三条有明确规定，上层股东不允许往下看。", "I'VE LOOKED DOWN FROM THIS LEVEL: THE WHOLE RING CITY LIES BELOW. ONLY LATER DID I LEARN THAT CHARTER ARTICLE III CLEARLY FORBIDS UPPER SHAREHOLDERS TO LOOK DOWN."]],
		Enemies.LEECH: [["我的工作就是回收电梯泄漏出去的空气，每回收一升都会把费用记到乘客的账单里。放心，这部分费用肯定不会漏算。", "MY JOB IS TO RECOVER THE AIR THAT LEAKS FROM THE LIFT, AND EVERY LITRE RECOVERED GOES ON THE PASSENGERS' BILL. DON'T WORRY, NONE OF THAT WILL BE LEFT OFF."]],
		Enemies.PULSE: [["刚才有人通知我气压又下降了，我看了一眼仪表以后就在最新的检查报告里填上了“一切正常”。", "SOMEONE JUST TOLD ME THE PRESSURE HAS DROPPED AGAIN. I GLANCED AT THE GAUGE AND WROTE 'ALL NORMAL' IN THE LATEST INSPECTION REPORT."]],
		Enemies.ECHO: [["所有登梯人员的名单一直都由我保管。这些年乘坐电梯上去的人越来越多，可我翻遍了返程记录，连一条都没有找到。", "I'VE ALWAYS KEPT THE LIST OF EVERYONE WHO BOARDS THE LIFT. MORE AND MORE PEOPLE HAVE GONE UP OVER THE YEARS, BUT I'VE SEARCHED ALL THE RETURN RECORDS AND NEVER FOUND A SINGLE ONE."]],
	},
	10: {
		Enemies.CHASER: [["我是 6620 号焊工，每天都在给战舰安装更厚的装甲。可我自己家里的墙已经裂了很久，到现在都攒不出维修的钱。", "I'M WELDER 6620. EVERY DAY I FIT THICKER ARMOUR TO THE WARSHIPS, BUT THE WALL AT HOME HAS BEEN CRACKED FOR AGES AND I STILL CAN'T SAVE ENOUGH TO FIX IT."],
			["第十三街今年的口粮配给被取消了。我去配给站领取物资的时候，工作人员给每户发了几块钢板，还告诉我们这是最新的民生保障政策。", "13TH STREET'S FOOD RATIONS WERE CANCELLED THIS YEAR. WHEN I WENT TO THE DISTRIBUTION POINT, THE STAFF GAVE EACH HOUSEHOLD A FEW STEEL PLATES AND TOLD US IT WAS THE NEW LIVELIHOOD SECURITY POLICY."]],
		Enemies.GUARD: [["这艘战舰叫“友谊号”，名字是上面的人定的。我负责给它安装炮塔，也知道这些火炮以后会用来对付下面的人。", "THIS WARSHIP IS CALLED THE FRIENDSHIP; THE PEOPLE ABOVE CHOSE THE NAME. I FIT ITS TURRETS, AND I KNOW THOSE GUNS WILL BE USED ON THE PEOPLE BELOW."]],
		Enemies.CHARGER: [["战舰下水那天我看见董事们举杯庆祝和平。有人问为什么要安装这么多火炮，他们说这是为了保障和平。", "THE DAY THE WARSHIP LAUNCHED, I SAW THE DIRECTORS RAISE THEIR GLASSES TO PEACE. SOMEONE ASKED WHY IT NEEDED SO MANY GUNS. THEY SAID IT WAS TO SAFEGUARD PEACE."]],
		Enemies.PRISM: [["这艘战舰原本是灰黑色的。每次新闻部门过来拍摄我都要把灯光调到最亮，因为上面要求和平的象征必须是白色的。", "THIS WARSHIP WAS ORIGINALLY DARK GREY. EVERY TIME THE NEWS DEPARTMENT COMES TO FILM, I HAVE TO TURN THE LIGHTS ALL THE WAY UP, BECAUSE THE PEOPLE ABOVE SAY THE SYMBOL OF PEACE MUST BE WHITE."]],
		Enemies.LEECH: [["我负责回收造船时剩下的焊渣。上面要求把这些材料全部送到兵工厂重新熔炼，听说下一批炮弹就要用这些材料制造。", "I COLLECT THE WELDING SLAG LEFT OVER FROM SHIPBUILDING. ORDERS ARE TO SEND IT ALL TO THE ARMOURY TO BE SMELTED AGAIN. I HEAR THE NEXT BATCH OF SHELLS WILL BE MADE FROM IT."]],
		Enemies.PULSE: [["我每天负责给船体安装铆钉。系统会把每一次敲击都算进我的生产业绩，但从来没有人告诉我这艘战舰以后要用来做什么。", "EVERY DAY I DRIVE RIVETS INTO THE HULL. THE SYSTEM COUNTS EVERY STRIKE TOWARD MY OUTPUT, BUT NO ONE HAS EVER TOLD ME WHAT THIS WARSHIP WILL BE USED FOR."]],
		Enemies.ECHO: [["他们说这些战舰都是为了维护和平才建造的。我已经登记了九十艘战舰，结果发现每一艘都叫“和平号”。", "THEY SAY THESE WARSHIPS ARE ALL BUILT TO KEEP THE PEACE. I'VE REGISTERED NINETY OF THEM, AND IT TURNS OUT EVERY ONE IS CALLED THE PEACE."]],
		Enemies.ESCORT: [["我负责护送的人享有最高级别的安全保障，系统却把我登记成了可替换资产。", "THE PERSON I ESCORT ENJOYS THE HIGHEST LEVEL OF PROTECTION, YET THE SYSTEM HAS ME REGISTERED AS A REPLACEABLE ASSET."]],
	},
	11: {
		Enemies.CHASER: [["我是 0703 号研究员，负责研究怎么让一秒钟变得更长。上周实验刚刚成功，主管就让我们先用这项技术延长员工的工作时间。", "I'M RESEARCHER 0703, STUDYING HOW TO MAKE A SECOND LAST LONGER. THE EXPERIMENT JUST SUCCEEDED LAST WEEK, AND MY SUPERVISOR WANTS US TO USE IT FIRST TO EXTEND STAFF WORKING HOURS."],
			["我查过研究所的设备资料，发现所有仪器虽然型号不同，但都是按照七百年前的一台机器设计的。为什么要采用这种设计，现在已经没人能够解释清楚了。", "I'VE CHECKED THE INSTITUTE'S EQUIPMENT RECORDS. EVERY INSTRUMENT IS A DIFFERENT MODEL, BUT ALL OF THEM WERE DESIGNED AFTER ONE MACHINE FROM SEVEN HUNDRED YEARS AGO. NO ONE CAN EXPLAIN ANYMORE WHY THEY WERE DESIGNED THAT WAY."]],
		Enemies.GUARD: [["我们以前可以直接通过观察窗观看实验过程，后来有人发现观测本身会影响实验结果。现在研究所已经把所有观察窗都封死了。", "WE USED TO WATCH THE EXPERIMENTS DIRECTLY THROUGH THE OBSERVATION WINDOWS. THEN SOMEONE FOUND THAT OBSERVING ITSELF CHANGES THE RESULTS. NOW THE INSTITUTE HAS SEALED EVERY WINDOW SHUT."]],
		Enemies.CHARGER: [["今年董事长刚满两百岁，研究所让我重新核对人类的寿命上限。连续调查了三次以后，我们终于确认了问题出在哪里，于是把正常寿命上限修改成了两百五十岁。", "THE CHAIRMAN TURNED TWO HUNDRED THIS YEAR, AND THE INSTITUTE HAD ME RECHECK THE LIMIT OF THE HUMAN LIFESPAN. AFTER THREE INVESTIGATIONS IN A ROW WE FINALLY FOUND WHERE THE PROBLEM WAS, AND CHANGED THE NORMAL LIMIT TO TWO HUNDRED AND FIFTY."]],
		Enemies.PRISM: [["上周那份观测报告一直没能通过审核。我把镜片稍微转动了一点，今天重新测量的时候所有数据就全部合格了。", "LAST WEEK'S OBSERVATION REPORT KEPT FAILING REVIEW. I TURNED THE LENS JUST A LITTLE, AND WHEN WE MEASURED AGAIN TODAY EVERY FIGURE PASSED."]],
		Enemies.LEECH: [["我的工作是回收市民每天浪费掉的时间。研究所认为这些时间留给普通人也没有什么用，所以让我全部转进董事们的个人账户。", "MY JOB IS TO COLLECT THE TIME CITIZENS WASTE EVERY DAY. THE INSTITUTE THINKS THAT TIME IS NO USE TO ORDINARY PEOPLE ANYWAY, SO I TRANSFER ALL OF IT TO THE DIRECTORS' PERSONAL ACCOUNTS."]],
		Enemies.PULSE: [["我负责管理董事会的时间账户，每过去一秒钟就要给他们增加一秒钟。账目上一直写着借用，可我从来没有找到过任何归还记录。", "I MANAGE THE BOARD'S TIME ACCOUNTS: FOR EVERY SECOND THAT PASSES, I ADD A SECOND TO THEIRS. THE BOOKS ALWAYS SAY 'BORROWED', BUT I'VE NEVER FOUND A SINGLE REPAYMENT."]],
		Enemies.ECHO: [["研究所给我制造了三个复制体，现在档案里面一共登记着四个我。我问研究员究竟哪个才是原来的我，他却告诉我只要四个人都能正常工作就没有问题。", "THE INSTITUTE MADE THREE COPIES OF ME, SO NOW FOUR OF ME ARE REGISTERED IN THE FILES. I ASKED A RESEARCHER WHICH ONE IS THE ORIGINAL ME. HE SAID AS LONG AS ALL FOUR CAN WORK NORMALLY, IT DOESN'T MATTER."]],
		Enemies.PHASE: [["我的实体化申请只批准了一半身体。我去找主管询问剩下的部分什么时候能够完成审批，他让我先用已经批准的那半边身体继续上班。", "MY MATERIALISATION REQUEST WAS ONLY APPROVED FOR HALF MY BODY. I ASKED MY SUPERVISOR WHEN THE REST WOULD BE APPROVED, AND HE TOLD ME TO KEEP COMING TO WORK WITH THE HALF THAT WAS APPROVED."]],
	},
	12: {
		Enemies.CHASER: [["我是 0001 号董事会警卫，也是最早入职的那批人。两百年过去了，后来入职的警卫都已经升职了，我却连董事长办公室的门都没有资格进去。", "I'M BOARD GUARD 0001, ONE OF THE VERY FIRST HIRES. TWO HUNDRED YEARS ON, EVERY GUARD HIRED AFTER ME HAS BEEN PROMOTED, AND I STILL AREN'T CLEARED TO ENTER THE CHAIRMAN'S OFFICE."],
			["我在董事长办公室门口站岗已经两百年了。这么多年他从来没有跟我说过一句话，有时候我甚至怀疑他根本不知道门口还有我这么一个人。", "I'VE STOOD GUARD AT THE CHAIRMAN'S OFFICE DOOR FOR TWO HUNDRED YEARS. IN ALL THAT TIME HE HAS NEVER SAID A WORD TO ME. SOMETIMES I WONDER IF HE EVEN KNOWS I'M HERE."]],
		Enemies.GUARD: [["今天又轮到我整理董事会的会议记录。董事长一个人决定了所有事情，我还得按照规定在文件上写明这项决议获得了全票通过。", "IT'S MY TURN TO WRITE UP THE BOARD MINUTES AGAIN TODAY. THE CHAIRMAN DECIDED EVERYTHING ALONE, BUT THE RULES SAY I MUST RECORD THAT THE RESOLUTION PASSED UNANIMOUSLY."]],
		Enemies.CHARGER: [["我负责核心区的温度管理，这里的空调一年到头都保持在二十六度。第十三街的居民已经连续三年申请恢复供暖了，可他们每次收到的答复都是能源配额不足。", "I MANAGE THE CORE'S TEMPERATURE. THE AIR CONDITIONING HERE STAYS AT TWENTY-SIX DEGREES ALL YEAR. 13TH STREET'S RESIDENTS HAVE APPLIED THREE YEARS RUNNING TO HAVE THEIR HEATING BACK, AND EVERY TIME THE ANSWER IS: INSUFFICIENT ENERGY QUOTA."],
			["我在白塔顶层已经站了六年岗，这里的高度甚至超过了云层。每天从窗户往外看都是一片白色，我到现在都没见过下面的地面是什么样子。", "I'VE STOOD GUARD AT THE TOP OF THE WHITE TOWER FOR SIX YEARS. IT'S EVEN HIGHER THAN THE CLOUDS. EVERY DAY IT'S WHITE OUTSIDE THE WINDOW, AND I STILL HAVE NO IDEA WHAT THE GROUND BELOW LOOKS LIKE."]],
		Enemies.PRISM: [["我负责维护全国广播使用的投影设备，这两百年来已经更换过无数台机器了。董事长的讲话每天都会在屏幕上播放，笑容从来没有发生过任何变化。", "I MAINTAIN THE PROJECTORS FOR THE NATIONAL BROADCAST, AND IN TWO HUNDRED YEARS I'VE REPLACED MORE MACHINES THAN I CAN COUNT. THE CHAIRMAN'S SPEECH PLAYS ON THE SCREENS EVERY DAY, AND HIS SMILE HAS NEVER CHANGED AT ALL."]],
		Enemies.LEECH: [["每位股东都要定期上交一小部分意识，统一存放在核心区。董事会说这是为了保障大家的利益。", "EVERY SHAREHOLDER MUST REGULARLY HAND OVER A SMALL PART OF THEIR MIND, ALL KEPT TOGETHER IN THE CORE. THE BOARD SAYS IT'S TO PROTECT EVERYONE'S INTERESTS."]],
		Enemies.PULSE: [["全国的心跳都由这里统一调节。我的工作就是维持这个节奏，谁的心跳不合拍，系统就会自动纠正。", "THE WHOLE COUNTRY'S HEARTBEAT IS REGULATED HERE. MY JOB IS TO HOLD THE RHYTHM. IF SOMEONE'S HEART FALLS OUT OF STEP, THE SYSTEM CORRECTS IT AUTOMATICALLY."]],
		Enemies.ECHO: [["董事长已经换过十一具身体了。每次换完，他都让我销毁旧照片。可我记得每一张脸，连他自己忘掉的那些也记得。", "THE CHAIRMAN HAS CHANGED BODIES ELEVEN TIMES. AFTER EACH CHANGE HE HAS ME DESTROY THE OLD PHOTOS. BUT I REMEMBER EVERY FACE, EVEN THE ONES HE HAS FORGOTTEN."]],
	},
}

